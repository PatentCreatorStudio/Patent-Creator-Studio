{
  "name": "patent-creator-studio",
  "version": "0.1.0-beta.13",
  "description": "Desktop studio for Claude Patent Creator",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node -e \"const fs=require('fs'),{execFileSync}=require('child_process');for(const d of ['src','ui'])for(const f of fs.readdirSync(d).filter(n=>n.endsWith('.js')))execFileSync(process.execPath,['--check',d+'/'+f],{stdio:'inherit'})\"",
    "dist": "node scripts/stage-repo.cjs && electron-builder --mac dir",
    "dist:mac": "node scripts/stage-repo.cjs && electron-builder --mac --arm64 --x64",
    "dist:win": "node scripts/stage-repo.cjs && electron-builder --win --x64"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "docx": "^9.15.3",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0"
  },
  "productName": "Patent Creator Studio",
  "private": true,
  "build": {
    "appId": "com.robthepcguy.patentcreatorstudio",
    "productName": "Patent Creator Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "ui/**",
      "package.json",
      "node_modules/**",
      "!build/**"
    ],
    "extraResources": [
      {
        "from": ".stage/patent-creator",
        "to": "patent-creator",
        "filter": [
          "**/*",
          "!studio/**",
          "!tests/**",
          ".claude-plugin/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ],
      "identity": null,
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "afterPack": "./scripts/adhoc-sign.cjs",
    "publish": {
      "provider": "github",
      "owner": "PatentCreatorStudio",
      "repo": "Patent-Creator-Studio"
    }
  }
}
